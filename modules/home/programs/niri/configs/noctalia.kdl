layout {

    focus-ring {
        active-color   "#ffb2b8"
        inactive-color "#200e10"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb2b8"
        inactive-color "#200e10"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb2b8"
        inactive-color "#ff506d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb2b880"
    }
}

recent-windows {
    highlight {
        active-color "#ffb2b8"
        urgent-color "#ffb4ab"
    }
}
